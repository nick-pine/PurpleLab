# Copy this file to .env and fill in real values for your local Wazuh lab.
# Never commit a real .env file -- it is already covered by .gitignore.

# Wazuh indexer (OpenSearch-compatible) base URL, e.g. https://localhost:9200
PURPLELAB_WAZUH_URL=https://localhost:9200

# Basic auth credentials for the Wazuh indexer.
PURPLELAB_WAZUH_USERNAME=admin
PURPLELAB_WAZUH_PASSWORD=changeme

# Optional. Defaults shown below.
# PURPLELAB_WAZUH_VERIFY_TLS=true
# PURPLELAB_WAZUH_TIMEOUT_SECONDS=10
# PURPLELAB_WAZUH_INDEX_PATTERN=wazuh-alerts-*
